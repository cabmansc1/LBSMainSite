# Copy to .env.local and fill in.
#
# Every name here is one the code actually reads. That is not a given:
# this file used to document RECAPTCHA_SITE_KEY, RECAPTCHA_SECRET_KEY,
# AUTH_URL, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, NEXT_PUBLIC_GTM_ID and
# NEXT_PUBLIC_GA_ID, none of which any file reads, while omitting
# RESEND_API_KEY, which decides whether the site can send mail at all.
# Two of those were set in production and did nothing.
#
# Grep before adding to this file:
#   grep -rn 'process\.env\.YOUR_VAR' src scripts

# --- Required ---------------------------------------------------------

# MySQL. The same database the PHP site uses.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Signs the session cookie. Falls back to a known dev string when unset,
# which is fine locally and unacceptable anywhere real.
AUTH_SECRET=

# The public address of this site, used for Stripe return URLs and for
# every link in an outgoing email. Behind Railway's proxy the request
# URL is http://localhost:8080, so this is not optional in production:
# without it customers pay and land on a dead tab.
#
# SITE_ORIGIN is accepted as an alias and read second. Set PUBLIC_SITE_URL.
# Do not leave a stale SITE_ORIGIN behind after a domain move.
PUBLIC_SITE_URL=https://www.lowcountrybusinessspotlight.com

# Stripe. Test keys until cutover; the app reads test-or-live off the
# key prefix rather than a separate flag.
STRIPE_SECRET_KEY=
# Accepts several, whitespace or comma separated, so a new endpoint can
# be added before the old one is retired.
STRIPE_WEBHOOK_SECRET=

# Mission Control: source of truth for card inventory and signups.
# MC_API_KEY_WRITE is preferred, MC_API_KEY_READONLY is the fallback,
# MC_API_KEY is the legacy single-key name still read for compatibility.
MC_BASE_URL=
MC_API_KEY_WRITE=
MC_API_KEY_READONLY=
MC_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------

# Without this the app renders mail and never sends it. There is no SMTP
# path here: the SMTP_* variables the PHP site used are not read by any
# file in this app.
RESEND_API_KEY=
EMAIL_FROM=Lowcountry Business Spotlight <hello@lowcountrybusinessspotlight.com>
EMAIL_REPLY_TO=
# Where "somebody needs to do something" mail goes. Defaults to the
# owner's address in lib/email.ts.
LEAD_ALERT_EMAIL=

# --- Optional ---------------------------------------------------------

# GoHighLevel. The catch-all covers every form; per-surface overrides
# are GHL_WEBHOOK_ADVERTISE, _QUIZ, _ROI, _NEWSLETTER, _WAITLIST, _ORDER.
GHL_WEBHOOK_URL=

# Where directory photos are served from. Points at whichever host holds
# /uploads; the value also builds next/image's remotePatterns at BUILD
# time, so changing it needs a redeploy rather than a restart.
UPLOADS_BASE_URL=https://www.lowcountrybusinessspotlight.com/uploads

# reCAPTCHA v3. Both or neither: the client only loads the script when
# the site key is set, and the server skips verification without the
# secret. The honeypot runs either way.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Directory map. Has a working default in the component; set this to use
# a key you have restricted to your own domains.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Safety flags for an environment sharing the production database.
# Set to 1 to block writes. Unset in production.
MC_READ_ONLY=
DIRECTORY_READ_ONLY=

# Shows the placeholder testimonials as a layout aid. Never set in
# production: they are not from real customers.
SHOW_SAMPLE_TESTIMONIALS=

# LowcoDeals feed. Both have working defaults.
LOWCODEALS_API=
LOWCODEALS_SITE=

# Scripts only, not the app. scrub-staging.mjs refuses to write unless
# SCRUB_ALLOW names the database it is pointed at; the e2e script uses
# CHROME_PATH to find a browser.
SCRUB_ALLOW=
CHROME_PATH=

# --- Analytics: nothing to set ----------------------------------------
#
# GA4, GTM, Meta Pixel and Google Ads IDs are hardcoded in
# src/components/analytics.tsx, matching seo_head.php lines 45-48. An
# unset NEXT_PUBLIC_ variable does not fail loudly, it renders the tag
# with an empty id and silently stops reporting, and losing Meta
# conversion signal without noticing is worse than a hardcoded string.
